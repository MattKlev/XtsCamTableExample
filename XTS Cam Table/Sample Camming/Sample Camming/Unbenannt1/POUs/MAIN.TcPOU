<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{275155d4-9e1e-44cf-bf5d-635d701e5b19}" SpecialFunc="None">
    <Declaration><![CDATA[// Disclaimer
