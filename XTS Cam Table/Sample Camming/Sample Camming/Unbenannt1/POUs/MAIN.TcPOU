// This publication may be changed from time to time without prior notice. No liability is assumed for errors and/or omissions. Our products are described in detail in our data sheets and documentations. Product-specific warnings and cautions must be observed. 
// For the latest version of our data sheets and documentations visit our website (www.beckhoff.de). 
//
// © Beckhoff Automation GmbH & Co. KG, 2022
// The reproduction, distribution and utilization of this document as well as the communication of its contents to others without express authorization is prohibited. Offenders will be held liable for the payment of damages. All rights reserved in the event of the grant of a patent, utility model or design.
PROGRAM MAIN
VAR
	Master					: AXIS_REF;			(* axis reference data structure *)
	Slave			 		: AXIS_REF;			(* axis reference data structure *)

	state					: MoveState_t;		(* state machine state *)

	PowerMaster				: MC_Power;
	PowerMasterOut			: ST_McOutputs;		(* debug function block output data *)
	PowerSlave				: MC_Power;
	PowerSlaveOut			: ST_McOutputs;		(* debug function block output data *)

	ResetMaster				: MC_Reset;
	ResetSlave				: MC_Reset;
	ResetMasterOut			: ST_McOutputs;		(* debug function block output data *)
	ResetSlaveOut			: ST_McOutputs;		(* debug function block output data *)

	MoveMaster 				: MC_MoveVelocity;
	MoveMasterOut			: ST_McOutputs;		(* debug function block output data *)
	MoveSlave				: MC_MoveAbsolute;
	MoveSlaveOut			: ST_McOutputs;		(* debug function block output data *)

	HaltMaster				: MC_Halt;
	HaltMasterOut			: ST_McOutputs;		(* debug function block output data *)
	HaltSlave				: MC_Halt;
	HaltSlaveOut			: ST_McOutputs;		(* debug function block output data *)

	CamIn					: MC_CamIn;			(* couple function block and cam table switching *)
	CamInOut				: ST_McOutputs;		(* debug function block output data *)
	CamOut					: MC_CamOut;
	CamOutOut				: ST_McOutputs;		(* debug function block output data *)

	CamTable1_StartPosition	: LREAL;
	CamTable2_StartPosition	: LREAL;

	CamInfo					: MC_CamInfo;
	CamInfoOut				: ST_McOutputs;		(* debug function block output data *)
	CamInfoData				: MC_CamInfoData;	(* debug function block output data *)

	CamScaling				: MC_CamScaling;
	CamScalingOut			: ST_McOutputs;		(* debug function block output data *)

	ReadMotionFunction			: MC_ReadMotionFunction;
	ReadMotionFunctionOut		: ST_McOutputs; (* debug function block output data *)
	MotionFunction				: ARRAY[1..10] OF MC_MotionFunctionPoint;
	CamTable					: MC_CAM_REF;
	WriteMotionFunctionPoint	: MC_WriteMotionFunctionPoint;
	WriteMotionFunctionPointOut	: ST_McOutputs; (* debug function block output data *)
	PointID						: UDINT := 2;

	SetCamOnlineChangeMode		: MC_SetCamOnlineChangeMode;
	SetCamOnlineChangeModeOut	: ST_McOutputs; (* debug function block output data *)

	MasterReadStatus			: MC_ReadStatus;
	MasterReadStatusOut			: ST_McOutputs;	(* debug function block output data *)
	SlaveReadStatus				: MC_ReadStatus;
	SlaveReadStatusOut			: ST_McOutputs;	(* debug function block output data *)
	override: LREAL := 10;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[	(* update the axis status at the beginning of each cycle *)
	Master();
	Slave();

	(* move axis using a state machine *)
	CASE state OF
		MOVESTATE_INIT :	(* initialisation *)
			(* initialize all function blocks *)
			MoveMaster.Execute := FALSE;
			MoveSlave.Execute := FALSE;
			ResetMaster.Execute := FALSE;
			ResetSlave.Execute := FALSE;
			CamIn.Execute := FALSE;
			CamOut.Execute := FALSE;
			HaltMaster.Execute := FALSE;
			HaltSlave.Execute := FALSE;
			ReadMotionFunction.Execute := FALSE;
			WriteMotionFunctionPoint.Execute := FALSE;
			SetCamOnlineChangeMode.ActivationMode := MC_CAMACTIVATION_NEXTCYCLE;
			CamScaling.Execute := FALSE;
			state := MOVESTATE_ENABLE;

		MOVESTATE_ENABLE :
			(* enable master and slave *)
			PowerMaster.Enable := TRUE;
			PowerMaster.Enable_Positive := TRUE;
			PowerMaster.Enable_Negative := TRUE;
			PowerSlave.Enable := TRUE;
			PowerSlave.Enable_Positive := TRUE;
			PowerSlave.Enable_Negative := TRUE;
			IF PowerMaster.Status AND PowerSlave.Status THEN
				state := MOVESTATE_FORWARD;
			ELSIF PowerMaster.Error OR PowerSlave.Error THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_FORWARD :
			(* start master endless in forward direction *)
			MoveMaster.Execute := TRUE;
			MoveMaster.Velocity := 1000;
			MoveSlave.Execute := TRUE;
			MoveSlave.Position := 0;
			MoveSlave.Velocity := 1000;
			IF MoveMaster.InVelocity AND MoveSlave.Done  THEN
				state := MOVESTATE_CAMIN;
			ELSIF MoveMaster.CommandAborted OR MoveMaster.Error OR MoveSlave.CommandAborted OR MoveSlave.Error THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_CAMIN :
			(* couple slave on the fly using cam table ID 1 *)
			CamIn.CamTableID := 1;
			CamIn.MasterOffset := 0;
			CamIn.SlaveOffset := 0;
			CamIn.MasterScaling := 1.0;
			CamIn.SlaveScaling := 1.0;
			CamIn.Options.ActivationMode := MC_CAMACTIVATION_NEXTCYCLE;	(* couple on the fly at the beginning of a cam cycle *)
			CamIn.Execute := TRUE;
			IF CamIn.InSync THEN
				CamTable1_StartPosition := Master.NcToPlc.SetPos;
				CamIn.Execute := FALSE;
				state := MOVESTATE_SWITCHCAM;
			ELSIF CamIn.CommandAborted OR CamIn.Error THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_SWITCHCAM :
			(* switch to cam table ID 2 after master moved for a certain distance *)
			IF Master.NcToPlc.SetPos > CamTable1_StartPosition + 3600 THEN
				CamIn.CamTableID := 2;
				CamIn.MasterOffset := 0;
				CamIn.SlaveOffset := 0;
				CamIn.MasterScaling := 1.0;
				CamIn.SlaveScaling := 1.0;
				CamIn.Options.ActivationMode := MC_CAMACTIVATION_NEXTCYCLE;	(* couple on the fly at the beginning of a cam cycle *)
				CamIn.Execute := TRUE;
				IF CamIn.InSync THEN
					CamTable2_StartPosition := Master.NcToPlc.SetPos;
					CamIn.Execute := FALSE;
					state := MOVESTATE_READCAMDATA;
				ELSIF CamIn.CommandAborted OR CamIn.Error THEN
					state := MOVESTATE_ERROR;
				END_IF
			END_IF

		MOVESTATE_READCAMDATA :
			(* read the cam data of cam table ID 2 *)
			CamTable.TableType := MC_TABLETYPE_MOTIONFUNCTION;
			CamTable.pArray := ADR(MotionFunction);
			CamTable.ArraySize := SIZEOF(MotionFunction);
			CamTable.NoOfColumns := 1;
			CamTable.NoOfRows := SIZEOF(MotionFunction) / SIZEOF(MotionFunction[1]);
			ReadMotionFunction.Execute := TRUE;
			IF ReadMotionFunction.Done THEN
				state := MOVESTATE_PREPARECAMMODIFICATION;
			ELSIF ReadMotionFunction.Error THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_PREPARECAMMODIFICATION :
			PointID := 2;
			(* modify a single point of cam table ID 2 - change slave position of point 2 *)
			IF NOT Slave.Status.CamDataQueued THEN
				IF Master.NcToPlc.SetPos > CamTable2_StartPosition + 3600 AND MotionFunction[PointID].SlavePos>50 THEN
					(* goto scaling mode after moving a certain distance *)
					state := MOVESTATE_CAMSCALING;
				ELSE
					(* select a new position for the second point of the cam table *)
					MotionFunction[PointID].SlavePos := SEL(MotionFunction[PointID].SlavePos > 50, 100, 20); (* toggle between 20 and 100 *)
					state := MOVESTATE_MODIFYCAM;
				END_IF
			END_IF

		MOVESTATE_MODIFYCAM :
			(* The modification takes place at the end of a cam cycle
			 * The modification mode has already been set after coupling the 
			 * slave with a call to SetCamOnlineChangeMode 
			 *)
			(* execute the modification of point 2 *)
			WriteMotionFunctionPoint.Execute := TRUE;
			IF WriteMotionFunctionPoint.Done THEN
				WriteMotionFunctionPoint.Execute := FALSE;
				state := MOVESTATE_PREPARECAMMODIFICATION;
			ELSIF WriteMotionFunctionPoint.Error THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_CAMSCALING :
			(* change the scaling of the cam table *)
			IF NOT Slave.Status.CamScalingPending THEN
				IF CamScaling.Done THEN
					CamScaling.Execute := FALSE;
				ELSIF CamScaling.CommandAborted OR CamScaling.Error THEN
					state := MOVESTATE_ERROR;
				ELSIF Master.NcToPlc.SetPos > CamTable2_StartPosition + 7200 THEN
					(* end of cam operation after a certain master distance *)
					state := MOVESTATE_STOPMASTER;
				ELSE
					(* check slave scaling factor and change it *)
					CamScaling.ActivationMode := MC_CAMACTIVATION_NEXTCYCLE;
					CamScaling.SlaveScalingMode := MC_CAMSCALING_USERDEFINED;
					CamScaling.SlaveScaling := SEL(CamScaling.SlaveScaling > 1.5, 2.0, 1.0); (* troggle between 1 and 2 *)
					CamScaling.SlaveOffset := 0;
					CamScaling.Execute := TRUE;
					state := MOVESTATE_MODIFYCAM;
				END_IF
			END_IF

		MOVESTATE_STOPMASTER :
			(* stop both axes (master with coupled slave) *)
			HaltMaster.Execute := TRUE;
			IF HaltMaster.Done THEN
				HaltMaster.Execute := FALSE;
				state := MOVESTATE_CAMOUT;
			ELSIF HaltMaster.Error OR HaltMaster.CommandAborted THEN
				HaltMaster.Execute := FALSE;
				state := MOVESTATE_CAMOUT;
			END_IF

		MOVESTATE_CAMOUT :
			(* decouple master and slave *)
			CamOut.Execute := TRUE;
			IF CamOut.Done THEN
				CamOut.Execute := FALSE;
				state := MOVESTATE_INIT;
			ELSIF CamOut.Error THEN
				CamOut.Execute := FALSE;
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_STOPAXES :
			(* stop both axes and the restart sample cycle *)
			HaltMaster.Execute := TRUE;
			HaltSlave.Execute := TRUE;
			IF HaltMaster.Done AND HaltSlave.Done THEN
				state := MOVESTATE_CAMOUT;
			ELSIF HaltMaster.Error OR HaltMaster.CommandAborted OR HaltSlave.Error OR HaltSlave.CommandAborted THEN
				state := MOVESTATE_ERROR;
			END_IF

		MOVESTATE_ERROR :
			CamOut.Execute := Slave.Status.Coupled; (* decouple if not already done before *)
			IF Master.Status.Error OR Slave.Status.Error THEN
				state := MOVESTATE_RESET;	(* axis error requires reset *)
			ELSE
				state := MOVESTATE_INIT;		(* function block errors don't need a reset *)
			END_IF

		MOVESTATE_RESET :
			ResetMaster.Execute := TRUE;
			ResetSlave.Execute := TRUE;
			IF ResetMaster.Done AND ResetSlave.Done THEN
				state := MOVESTATE_INIT;
			ELSIF ResetMaster.Error OR ResetSlave.Error THEN
				state := MOVESTATE_INIT; (* can't do anything here *)
			END_IF

	END_CASE

	ActPower();		(* call the power function block *)
	ActMove();		(* call the move function block *)
	ActReset();		(* call the reset function block *)
	ActCamming();	(* call the camming function blocks *)
]]></ST>
    </Implementation>
    <Action Name="ActCamming" Id="{aa80a210-6d02-48f0-8d02-932d70f872b3}">
