<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_State" Id="{84637ff5-a0c4-42fe-8352-3df8751e49a1}">
    <Declaration><![CDATA[// Steps of the demo sequence in MAIN
TYPE E_State :
(
	Idle,			// waiting for bStart
	Enable,			// MC_Power on both movers
	BuildTable,		// fill the point array and load it into NC cam table 1 (MC_CamTableSelect)
	ReadTable,		// ask the NC where the table wants Mover 2 for Mover 1's current position
	Preposition,	// move Mover 2 there (MC_MoveRelative, Mover 1 stands still)
	CamIn,			// couple Mover 2 to Mover 1 (MC_CamIn)
	Run,			// Mover 1 runs at constant velocity, Mover 2 follows the cam
	Stopping,		// MC_Halt on Mover 1 (Mover 2 follows it to a stop)
	CamOut,			// decouple (MC_CamOut)
	Error,			// something failed - set bReset
	Resetting		// MC_Reset on both movers
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
