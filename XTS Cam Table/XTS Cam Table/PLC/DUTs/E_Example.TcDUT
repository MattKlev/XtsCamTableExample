<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Example" Id="{840659f7-54af-4a4a-b0c6-fb5596a318ae}">
    <Declaration><![CDATA[// Which example program MAIN calls. Pick one in the online view (MAIN.eExample), then start it from that program.
TYPE E_Example :
(
	ConstantGap,		// PRG_Example1: 9 points, Mover 2 a fixed distance behind Mover 1, 100 mm on the straights /
						// 60 mm in the curves (F_CamPoint)
	ClothoidBallGap,	// PRG_Example2: 18 points, the two movers pinch a ball between them like tongs and keep their
						// jaws a constant distance apart along the ball's path through the curve transitions
						// (FB_XtsBallCamBuilder)
	StitchedSegments,	// PRG_Example3: the same 18 points, assembled from a track layout and ONE module-relative
						// clothoid piece (FB_XtsCamStitcher)
	TwoTableSwitching,	// PRG_Example4: two NC tables, a 2-point straight line and the 10-point clothoid piece. The NC
						// swaps them at the curve boundaries while running
	VirtualMasterSplit	// PRG_Example5: the BALL is the master. A virtual axis runs along the ball's path at constant
						// speed and both movers follow it through their own 10-point table, so the curve work of
						// example 2 is split between them and neither ever runs faster than the ball
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
