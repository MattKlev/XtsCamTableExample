<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Example" Id="{840659f7-54af-4a4a-b0c6-fb5596a318ae}">
    <Declaration><![CDATA[// Which cam table MAIN builds. Pick one in the online view (MAIN.eExample) before bStart.
TYPE E_Example :
(
	ConstantGap,		// 9 points: Mover 2 a fixed distance behind Mover 1, 100 mm on the straights / 60 mm in the curves
						// (MAIN.BuildTable_ConstantGap, F_CamPoint)
	ClothoidBallGap		// 18 points: each mover carries a ball outboard of the track, the balls keep a constant distance
						// along the ball path through the curve transitions (MAIN.BuildTable_Clothoid, FB_XtsBallCamBuilder)
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
