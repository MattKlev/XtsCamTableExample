<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{02d0078e-12f3-48cc-91d0-47852b4af7ae}" SpecialFunc="None">
    <Declaration><![CDATA[// XTS cam table demo - as simple as it gets.
//
//   Mover 1 = master, runs at constant velocity around the track.
//   Mover 2 = slave, follows Mover 1 through a cam table.
//
// Five examples, each a self-contained program with its own constants, table builder and sequence:
//
//   PRG_Example1  ConstantGap        9 points. Mover 2 is 100 mm behind Mover 1 on the straights and 60 mm in the
//                                    curves, blended at the start of every section. Written by hand with F_CamPoint.
//   PRG_Example2  ClothoidBallGap    18 points from FB_XtsBallCamBuilder. The two movers pinch one ball between them
//                                    like tongs: each carries a jaw outboard of the track, and the table keeps the
//                                    jaws a constant distance apart along the ball's path so the ball stays clamped
//                                    through the curves (Mover 2 speeds up going in, slows down coming out).
//   PRG_Example3  StitchedSegments   The same 18 points, assembled from pieces: ONE module-relative clothoid piece
//                                    that FB_XtsCamStitcher pastes wherever the track layout says "Curve".
//   PRG_Example4  TwoTableSwitching  Two NC tables, a straight line and the clothoid piece. While running, the NC
//                                    swaps them at the curve boundaries (MC_CamIn on the coupled slave).
//   PRG_Example5  VirtualMasterSplit The BALL is the master: a virtual axis runs along the ball's path at constant
//                                    speed and BOTH movers are slaves with their own 10-point table. The curve work
//                                    that Mover 2 did alone in example 2 is split between the two movers.
//
// How to run (online view):  pick eExample here, then open that program: bStart -> watch eState -> bStop.
// On Error: bReset.   The examples share the two movers (GVL_Axes), so only the selected program is called.
// A new eExample takes effect once the running example is back in Idle.
PROGRAM MAIN
VAR
	eExample		: E_Example := E_Example.ConstantGap;	// which example to run
	eExampleActive	: E_Example;	// the one being called right now
	bIdle			: BOOL;			// the active example is in Idle, so it is safe to switch
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eExampleActive OF
	E_Example.ConstantGap:			PRG_Example1();		bIdle := PRG_Example1.eState = E_State.Idle;
	E_Example.ClothoidBallGap:		PRG_Example2();		bIdle := PRG_Example2.eState = E_State.Idle;
	E_Example.StitchedSegments:		PRG_Example3();		bIdle := PRG_Example3.eState = E_State.Idle;
	E_Example.TwoTableSwitching:	PRG_Example4();		bIdle := PRG_Example4.eState = E_State.Idle;
	E_Example.VirtualMasterSplit:	PRG_Example5();		bIdle := PRG_Example5.eState = E_State.Idle;
END_CASE

IF bIdle THEN
	eExampleActive := eExample;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>